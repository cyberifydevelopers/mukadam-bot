# ---------------------------------------------------------------------------
# Google OAuth (Gmail read + Sheets write share one token).
# One-time setup: create these in Google Cloud Console (see
# docs/WORKFLOW.md "Google API setup"), then run
# `python scripts/gmail_oauth_setup.py` locally to produce token.json.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_SECRETS_FILE=./credentials/client_secret.json
GOOGLE_TOKEN_FILE=./credentials/token.json
# On hosts with no file upload (e.g. Railway): paste the whole contents of
# token.json here instead; the app writes it to GOOGLE_TOKEN_FILE on startup.
GOOGLE_TOKEN_JSON=

# ---------------------------------------------------------------------------
# Gmail API push (real-time ingestion via Cloud Pub/Sub).
# GOOGLE_PUBSUB_TOPIC is the full resource name:
#   projects/<your-gcp-project-id>/topics/<your-topic-name>
# PUBSUB_VERIFICATION_TOKEN is a random string YOU generate and put both
# here and in the push subscription's endpoint URL as ?token=... — it's
# what stops random internet traffic from hitting /webhook/gmail.
# ---------------------------------------------------------------------------
GOOGLE_PUBSUB_TOPIC=
# PULL subscription on that topic — the app listens on it for new mail, so no
# public URL / tunnel is needed (leave empty to use a push subscription to
# /webhook/gmail instead, or only the periodic check). Full name
# projects/<id>/subscriptions/<name>, or just <name>. Needs the pubsub scope
# in token.json: re-run `python scripts/gmail_oauth_setup.py` once.
GOOGLE_PUBSUB_SUBSCRIPTION=
PUBSUB_VERIFICATION_TOKEN=
GMAIL_WATCH_LABEL_IDS=INBOX
GMAIL_WATCH_RENEW_INTERVAL_SECONDS=43200
# Fallback only: poll Gmail this often when the Pub/Sub listener isn't running
# (0 = never). With GOOGLE_PUBSUB_SUBSCRIPTION working there is no polling.
GMAIL_RECONCILE_INTERVAL_SECONDS=900

# ---------------------------------------------------------------------------
# Google Sheets output — one spreadsheet, one tab per bank.
# Create a blank spreadsheet, share it with yourself (owner), and copy the
# id out of its URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=

# ---------------------------------------------------------------------------
# LLM-first PDF extraction — default parser for any bank registered in
# bank_registry.py that doesn't yet have a hand-written rule-based parser.
# Not needed for a bank once it has its own parser (parser= override).
# Routed through OpenRouter (openrouter.ai) — get a key there, then pick any
# model it serves for LLM_EXTRACTION_MODEL (e.g. anthropic/claude-sonnet-4.5,
# openai/gpt-4o-mini, google/gemini-2.5-flash).
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_EXTRACTION_MODEL=anthropic/claude-sonnet-4.5

# ---------------------------------------------------------------------------
# Per-bank PDF passwords — one var per BankProfile.pdf_password_env in
# app/bank_registry.py.
# ---------------------------------------------------------------------------
# Bank AL Habib e-Statement: 13-digit CNIC, no dashes.
BAHL_PDF_PASSWORD=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta). Requires a Meta Business Account + a WhatsApp
# Business App with the Cloud API product added, a verified phone number,
# and an approved message TEMPLATE (see docs/WORKFLOW.md — this is required,
# a business-initiated message cannot use free-form interactive buttons).
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=invoice_confirmation
WHATSAPP_TEMPLATE_LANG=en

# Which integration sends the prompt: "meta" (Cloud API above) or "openwa".
WHATSAPP_PROVIDER=meta

# ---------------------------------------------------------------------------
# OpenWA (self-hosted, unofficial — https://github.com/rmyndharis/OpenWA).
# Runs in Docker on the same machine; links a WhatsApp number by QR scan.
# OPENWA_API_KEY: from the OpenWA dashboard (or data/.api-key in its folder).
# OPENWA_SESSION_ID: the session's id (GET /api/sessions).
# OPENWA_WEBHOOK_SECRET: random string (16+ chars) — the same value is set as
# the `secret` when registering the webhook to
# http://host.docker.internal:8000/webhook/openwa (see docs/WORKFLOW.md).
# ---------------------------------------------------------------------------
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=

# Recipient(s) who should receive confirmation prompts, E.164 format,
# comma-separated if more than one person approves entries.
NOTIFY_WHATSAPP_NUMBERS=

# ---------------------------------------------------------------------------
# App/db
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/mukadam_bot.db
PDF_STORAGE_DIR=./data/pdfs
LOG_LEVEL=INFO

# true = outgoing connections use IPv4 only. Turn on if Google calls fail with
# SSLEOFError / UNEXPECTED_EOF_WHILE_READING (broken IPv6 route).
FORCE_IPV4=false

# true = every email is checked by the LLM in full (subject, text, logos, pictures).
# false = emails that name no bank and have no pictures are skipped without an LLM call.
SCAN_ALL_EMAILS=true

# Our company names / email addresses, comma-separated. Each bank document is checked to be
# addressed to / about one of them; a warning is shown on the WhatsApp prompt if not.
OUR_COMPANY_NAMES=
